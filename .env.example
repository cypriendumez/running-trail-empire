# Copy this file to .env.local and fill in your values

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

NEXT_PUBLIC_MAPBOX_TOKEN=

# Gemini Flash (free tier — replaces OpenAI)
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Intervals.icu — free gateway for Garmin/Coros/Strava data
# Get at https://intervals.icu/settings (API key + athlete ID)
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# OpenWeather — free tier (< 1000 calls/day)
# Get at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Admin secret for the /admin workflow (set a strong random string)
ADMIN_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=
