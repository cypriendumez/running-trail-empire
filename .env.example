# Copy this file to .env.local and fill in your values

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Four price IDs — two plans x two billing periods. The purchased price decides which
# plan the account gets: a single price id would grant Premium to someone paying Starter.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Webhook endpoint: https://<your-domain>/api/stripe/webhook
# Events to enable: invoice.paid, charge.refunded, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
# Without STRIPE_WEBHOOK_SECRET the endpoint refuses every call (503) on purpose:
# an unverified webhook would let anyone grant a subscription or write fake revenue.

NEXT_PUBLIC_MAPBOX_TOKEN=

# MapTiler — "Outdoor" map (relief + trails) for the Trail Builder
# Free key at https://cloud.maptiler.com → Account → API keys
NEXT_PUBLIC_MAPTILER_KEY=

# Gemini Flash (free tier — replaces OpenAI)
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Intervals.icu — free gateway for Garmin/Coros/Strava data
# Get at https://intervals.icu/settings (API key + athlete ID)
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# OpenWeather — free tier (< 1000 calls/day)
# Get at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Who can open the coach workspace (/admin). Comma-separated e-mail addresses.
# Leave EMPTY and the historical owner keeps access; set it and ONLY these addresses
# get in — no redeploy needed. A value that contains no valid address closes /admin
# for everyone on purpose: falling back to the previous owner would silently hand the
# keys back after a typo.
# Server-side only — never prefix with NEXT_PUBLIC_.
ADMIN_EMAILS=

# Where the editor is NOTIFIED: new signup, athlete message, painful RPE, race goal.
# These e-mails carry athletes' PERSONAL DATA (name, address, pain, fitness).
# Leave empty and the FIRST address of ADMIN_EMAILS is used — so handing the app over
# takes one variable, not two. If neither is readable, NOTHING is sent: not warning the
# editor shows up in the logs, warning the wrong person does not.
COACH_EMAIL=

# Transactional e-mail (Resend). Without these, no alert leaves the server at all.
# RESEND_FROM must be a verified sender, e.g. "Pacevo <bonjour@ton-domaine.fr>".
RESEND_API_KEY=
RESEND_FROM=

# Admin secret for the /admin workflow (set a strong random string)
ADMIN_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=
