    "verify": "npx tsc --noEmit && npm test",
    "gear:decouvrir": "npx tsx scripts/decouverte-irun.ts",
    "gear:prix": "npx tsx scripts/decouverte-irun.ts --prix && npx tsx scripts/import-offres.ts",
