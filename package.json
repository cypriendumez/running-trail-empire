    "gear:flux": "npx tsx scripts/import-flux.ts",
    "gear:irun": "npx tsx scripts/collecte-irun.ts",
    "gear:specs": "npx tsx scripts/collecte-specs.ts",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "sync:maplibre": "cp node_modules/maplibre-gl/dist/maplibre-gl-csp-worker.js public/maplibre-gl-csp-worker.js",
    "seo:soumettre": "npx --yes tsx scripts/indexnow.ts",
    "sauvegarde": "npx --yes tsx scripts/sauvegarde.ts",
    "restaurer": "npx --yes tsx scripts/restaurer.ts"
  },
